# Виртуальные окружения
.venv/
venv/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# Данные (тяжелые, только локально)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.parquet

# Личные артефакты
outputs/vlad/*
outputs/egor/*
outputs/andrew/*
!outputs/vlad/.gitkeep
!outputs/egor/.gitkeep
!outputs/andrew/.gitkeep

# Модели
*.pkl
*.joblib
*.h5
*.pt

# Архивы (страховка от случайного коммита)
*.zip
*.gz

# Изображения и таблицы вне reports
*.png
*.csv

# ИСКЛЮЧЕНИЯ: финальные отчёты идут в git
!reports/**